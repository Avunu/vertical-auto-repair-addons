<odoo>
    <!-- `vite` is what the controller read from the build's manifest. -->
    <template id="index" name="Repair Job Board">&lt;!DOCTYPE html&gt;
<html lang="en">
        <head>
            <meta charset="utf-8" />
            <title t-out="pwa.name" />
            <t t-call="repair_tech_api.pwa_head" />
            <!-- A launching iPad app shows the page before its stylesheet loads. -->
            <style>html { background: #0c1118; }</style>
            <link
                t-foreach="vite['css']"
                t-as="href"
                rel="stylesheet"
                t-att-href="href"
            />
            <link
                t-foreach="vite['preload']"
                t-as="href"
                rel="modulepreload"
                t-att-href="href"
            />
            <script type="module" t-att-src="vite['script']" />
        </head>
        <body>
            <div id="app" />
        </body>
    </html>
    </template>
</odoo>
