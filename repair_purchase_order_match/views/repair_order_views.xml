<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_repair_order_list_choose_for_po" model="ir.ui.view">
        <field name="name">repair.order.list.choose.for.po</field>
        <field name="model">repair.order</field>
        <field name="arch" type="xml">
            <list
                string="Select a Repair Order"
                create="0"
                delete="0"
                import="0"
                action="action_link_purchase_order"
                type="object"
            >
                <field name="name" />
                <field name="partner_id" />
                <field name="vehicle_id" />
                <field name="customer_concern" optional="hide" />
                <field name="schedule_date" />
                <field name="state" />
            </list>
        </field>
    </record>

    <!-- Match Order: sits where the time control's Start Timer used to be,
         i.e. right before the statusbar. Shown to who has the access rights
         the match needs (`repair_match_can_link`). -->
    <record id="view_repair_order_form_match_order" model="ir.ui.view">
        <field name="name">repair.order.form.match.order</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state']" position="before">
                <button
                    name="action_match_order"
                    string="Match Order"
                    type="object"
                    invisible="state in ('done', 'cancel') or not repair_match_can_link"
                />
                <field name="repair_match_can_link" invisible="1" />
            </xpath>
            <!-- Match Order replaces the Parts tab's "Purchase Orders"
                 picker (repair_purchase_order_parts). -->
            <button name="action_add_from_purchase_order_repair" position="replace" />
        </field>
    </record>

    <!-- Opened from a purchase order's chatter as
         /odoo/<purchase order id>/action-<this action>, so active_id is
         the purchase order. -->
    <record id="action_repair_order_choose_for_po" model="ir.actions.act_window">
        <field name="name">Select a Repair Order</field>
        <field name="res_model">repair.order</field>
        <field name="view_mode">list</field>
        <field
            name="view_ids"
            eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_repair_order_list_choose_for_po')})]"
        />
        <field name="domain">[('state', 'not in', ('done', 'cancel'))]</field>
        <field name="context">{'po_id': active_id}</field>
    </record>
</odoo>
