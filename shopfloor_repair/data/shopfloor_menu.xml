<odoo>
    <!--
        One menu item, deliberately. The technician picks a job once and the
        job_detail state is the hub for time, parts and inspections; four menu
        items would mean re-selecting the job for every action.
    -->
    <record id="shopfloor_menu_my_jobs" model="shopfloor.menu">
        <field name="name">My Jobs</field>
        <field name="sequence">10</field>
        <field name="profile_id" ref="shopfloor_profile_technician" />
        <field name="scenario_id" ref="shopfloor_scenario_repair_job" />
    </record>
</odoo>
