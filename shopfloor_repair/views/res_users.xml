<odoo>
    <record id="view_users_form_shopfloor_default_profile" model="ir.ui.view">
        <field name="name">res.users.form.shopfloor.default.profile</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='share']" position="after">
                <field
                    name="shopfloor_default_profile_id"
                    groups="shopfloor_base.group_shopfloor_manager"
                />
            </xpath>
        </field>
    </record>
</odoo>
