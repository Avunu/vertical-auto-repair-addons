<odoo>
    <record id="repair_service_confirm_wizard_view_form" model="ir.ui.view">
        <field name="name">repair.service.confirm.wizard.form</field>
        <field name="model">repair.service.confirm.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm Repair">
                <group>
                    <field name="repair_id" readonly="1" />
                    <field name="technician_id" />
                </group>
                <separator string="Services" />
                <field name="service_line_ids">
                    <list editable="bottom" create="0" delete="0">
                        <field name="accepted" />
                        <field name="service_id" column_invisible="1" force_save="1" />
                        <field name="product_id" readonly="1" />
                        <field name="display_name" readonly="1" />
                        <field name="estimated_time" readonly="1" widget="float_time" />
                    </list>
                </field>
                <separator string="Parts" />
                <field name="move_ids" readonly="1">
                    <list>
                        <field name="product_id" />
                        <field name="product_uom_qty" />
                        <field name="product_uom" />
                    </list>
                </field>
                <div class="mt-2">
                    <button
                        name="action_add_parts_catalog"
                        type="object"
                        string="Add from Catalog"
                        class="px-4 btn-link"
                    />
                    <button
                        name="action_add_parts_po"
                        type="object"
                        string="Add from Purchase Order"
                        class="px-4 btn-link"
                    />
                </div>
                <footer>
                    <button
                        name="action_confirm"
                        type="object"
                        string="Confirm Repair"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
