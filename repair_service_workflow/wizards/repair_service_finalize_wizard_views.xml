<odoo>
    <record id="repair_service_finalize_wizard_view_form" model="ir.ui.view">
        <field name="name">repair.service.finalize.wizard.form</field>
        <field name="model">repair.service.finalize.wizard</field>
        <field name="arch" type="xml">
            <form string="Finalize Repair">
                <group>
                    <field name="repair_id" readonly="1" />
                    <field name="technician_id" readonly="1" />
                </group>
                <separator string="Billable Parts" />
                <field name="move_ids" readonly="1">
                    <list>
                        <field name="product_id" />
                        <field name="product_uom_qty" />
                        <field name="product_uom" />
                    </list>
                </field>
                <separator string="Billable Services" />
                <field name="service_line_ids" readonly="1">
                    <list create="0" delete="0">
                        <field name="service_id" column_invisible="1" force_save="1" />
                        <field name="product_id" />
                        <field name="display_name" />
                        <field name="product_uom_qty" />
                        <field name="estimated_time" widget="float_time" />
                        <field name="actual_time" widget="float_time" />
                    </list>
                </field>
                <footer>
                    <button
                        name="action_finalize"
                        type="object"
                        string="Finalize &amp; End Repair"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
