<odoo>
    <template
        id="report_repairorder_workflow"
        inherit_id="repair.report_repairorder"
        priority="99"
    >
        <!-- Only print the Parts section when the order has parts. -->
        <xpath expr="//h2[normalize-space()='Parts']" position="attributes">
            <attribute name="t-if">o.move_ids</attribute>
        </xpath>
        <xpath expr="(//table[hasclass('o_main_table')])[1]" position="attributes">
            <attribute name="t-if">o.move_ids</attribute>
        </xpath>
        <!-- Service quantity is time (hours), which customers don't need to see. -->
        <xpath
            expr="//t[@t-if='o.repair_service_ids']//thead//th[hasclass('text-end')]"
            position="replace"
        />
        <xpath
            expr="//tr[@t-foreach='o.repair_service_ids']/td[hasclass('text-end')]"
            position="replace"
        />
    </template>
</odoo>
