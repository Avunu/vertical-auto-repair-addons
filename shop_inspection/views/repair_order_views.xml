<odoo>
    <record id="view_repair_order_form" model="ir.ui.view">
        <field name="name">repair.order.form (in shop_inspection)</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    name="action_view_inspections"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-check-square-o"
                    invisible="inspection_count == 0"
                >
                    <field
                        name="inspection_count"
                        widget="statinfo"
                        string="Inspections"
                    />
                </button>
            </div>
            <xpath expr="//header/button[last()]" position="after">
                <button
                    name="action_new_inspection"
                    type="object"
                    string="New Inspection"
                    invisible="state in ('done', 'cancel')"
                />
            </xpath>
            <xpath expr="//sheet//field[@name='partner_id']" position="after">
                <field name="service_advisor_id" />
                <field name="technician_id" />
            </xpath>
        </field>
    </record>
</odoo>
