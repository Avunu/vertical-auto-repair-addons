<odoo noupdate="1">
    <!-- Checklist lines are individual records with their own XML IDs rather
         than Command.create() commands inline on the template.

         Inline commands only ever append: they carry no identity, so a module
         update that reached this data would add a second copy of every line
         instead of updating the ones already there. The noupdate flag above
         hides that, at the cost of never being able to ship a correction to a
         checklist at all, and one edit removing the flag would silently
         double every template.

         With an XML ID per line the data is identified, so it can be
         corrected, reordered or retired safely. See migrations/18.0.1.1.0 for
         the cleanup of installs that already drifted. -->

    <record id="template_check_in" model="fleet.vehicle.inspection.template">
        <field name="name">Check In</field>
    </record>
    <record
        id="line_check_in_safety_sticker"
        model="fleet.vehicle.inspection.template.line"
    >
        <field name="inspection_template_id" ref="template_check_in" />
        <field name="inspection_template_item_id" ref="item_safety_sticker" />
        <field name="sequence">10</field>
    </record>
