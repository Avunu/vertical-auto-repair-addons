<odoo>
    <!--
        The group is created empty on purpose: keys carry identities and must
        never ship as data. Create one auth.api.key per technician (Settings >
        Technical > API Keys), point its user at that technician, and add it
        here. See the module README.
    -->
    <record id="auth_api_key_group_technician" model="auth.api.key.group">
        <field name="name">Repair Shop Technicians</field>
        <field name="code">repair_shop_technician</field>
    </record>
</odoo>
