<odoo>
    <record id="resource_booking_type_view_form" model="ir.ui.view">
        <field name="name">resource.booking.type.form (in repair_tech_api)</field>
        <field name="model">resource.booking.type</field>
        <field
            name="inherit_id"
            ref="shop_scheduling.resource_booking_type_view_form"
        />
        <field name="arch" type="xml">
            <field name="color" position="after">
                <field name="board_icon" />
                <field
                    name="board_label"
                    invisible="not board_icon"
                    placeholder="Same as the name"
                />
            </field>
        </field>
    </record>
</odoo>
