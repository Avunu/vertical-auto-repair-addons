<odoo>
    <record id="repair_order_stage_view_list" model="ir.ui.view">
        <field name="name">repair.order.stage.list.board</field>
        <field name="model">repair.order.stage</field>
        <field name="inherit_id" ref="repair_stage.repair_order_stage_view_list" />
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="board_status" optional="show" />
            </field>
        </field>
    </record>

    <record id="repair_order_stage_view_form" model="ir.ui.view">
        <field name="name">repair.order.stage.form.board</field>
        <field name="model">repair.order.stage</field>
        <field name="inherit_id" ref="repair_stage.repair_order_stage_view_form" />
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="board_status" />
            </field>
        </field>
    </record>
</odoo>
