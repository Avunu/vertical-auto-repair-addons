<odoo>
    <record id="view_repair_order_form" model="ir.ui.view">
        <field name="name">repair.order.form (in shop_estimate)</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="shop_inspection.view_repair_order_form" />
        <field name="arch" type="xml">
            <button name="action_new_inspection" position="after">
                <button
                    name="%(shop_estimate.shop_estimate_builder_action)d"
                    type="action"
                    string="Build Estimate"
                    invisible="inspection_count == 0 or state in ('done', 'cancel')"
                />
            </button>
        </field>
    </record>
</odoo>
