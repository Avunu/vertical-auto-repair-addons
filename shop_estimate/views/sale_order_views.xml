<odoo>
    <record id="sale_order_form_quote" model="ir.ui.view">
        <field name="name">sale.order.form (in shop_estimate)</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_management.sale_order_form_quote" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='sale_order_option_ids']//list//field[@name='name']"
                position="before"
            >
                <field name="shop_job_id" optional="hide" />
                <field name="shop_repair_id" column_invisible="1" />
                <field name="shop_finding_line_id" column_invisible="1" />
            </xpath>
        </field>
    </record>
    <record id="sale_order_form" model="ir.ui.view">
        <field name="name">sale.order.form lines (in shop_estimate)</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='order_line']//list//field[@name='product_id']"
                position="after"
            >
                <field name="shop_job_id" optional="hide" />
                <field name="shop_repair_id" column_invisible="1" />
                <field name="shop_finding_line_id" column_invisible="1" />
                <field name="shop_job_exploded" column_invisible="1" />
            </xpath>
        </field>
    </record>
</odoo>
