<templates xml:space="preserve">

    <!-- Customer on top, then the vehicle, then the order reference; the
         month grid is one line per job. No time: the grid's own hour labels
         already say when, and the customer is what a card was missing.
         Falls back to the order reference for a job with neither. -->
    <t t-name="shop_scheduling.RepairCalendarEvent">
        <t
            t-set="customer"
            t-value="rawRecord.partner_id and rawRecord.partner_id[1]"
        />
        <t t-set="vehicle" t-value="rawRecord.shop_vehicle_label" />
        <div class="o_event_title text-truncate">
            <t t-if="isMonth">
                <t t-if="customer">
                    <t t-esc="customer" />
                    <t t-if="vehicle"> · </t>
                </t>
                <span t-if="vehicle" class="fw-bold" t-esc="vehicle" />
                <span t-if="!customer and !vehicle" class="fw-bold" t-esc="title" />
            </t>
            <t t-else="">
                <div t-if="customer" class="text-truncate" t-esc="customer" />
                <div t-if="vehicle" class="fw-bold text-truncate" t-esc="vehicle" />
                <div
                    t-att-class="'text-truncate' + (customer or vehicle ? ' fw-normal' : ' fw-bold')"
                    t-esc="title"
                />
            </t>
        </div>
    </t>

</templates>
