<odoo>
    <record id="resource_booking_view_form" model="ir.ui.view">
        <field name="name">resource.booking.form (in shop_scheduling)</field>
        <field name="model">resource.booking</field>
        <field name="inherit_id" ref="resource_booking.resource_booking_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//header/button[last()]" position="after">
                <button
                    name="action_shop_show_openings"
                    type="object"
                    string="Show Openings"
                    help="List the slots this appointment really fits in, and book one."
                />
                <button
                    name="action_shop_create_repair"
                    type="object"
                    string="Create Repair Order"
                    invisible="repair_id"
                />
            </xpath>
            <div name="button_box" position="inside">
                <button
                    name="action_view_repair"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-wrench"
                    invisible="not repair_id"
                >
                    <span>Repair Order</span>
                </button>
            </div>
            <field name="type_id" position="after">
                <field name="repair_id" />
                <field name="vehicle_id" invisible="not vehicle_id" />
            </field>
        </field>
    </record>

    <record id="resource_booking_view_search" model="ir.ui.view">
        <field name="name">resource.booking.search (in shop_scheduling)</field>
        <field name="model">resource.booking</field>
        <field name="inherit_id" ref="resource_booking.resource_booking_view_search" />
        <field name="arch" type="xml">
            <field name="combination_id" position="after">
                <field name="repair_id" />
                <field name="vehicle_id" />
                <field name="technician_id" />
            </field>
            <filter name="groupby_combination_id" position="after">
                <filter
                    string="Technician"
                    name="groupby_technician_id"
                    context="{'group_by': 'technician_id'}"
                />
            </filter>
        </field>
    </record>

    <record id="resource_booking_view_calendar" model="ir.ui.view">
        <field name="name">resource.booking.calendar (in shop_scheduling)</field>
        <field name="model">resource.booking</field>
        <field
            name="inherit_id"
            ref="resource_booking.resource_booking_view_calendar"
        />
        <field name="arch" type="xml">
            <calendar position="attributes">
                <attribute name="color">technician_id</attribute>
            </calendar>
            <field name="combination_id" position="after">
                <field name="technician_id" />
                <field name="vehicle_id" />
            </field>
        </field>
    </record>

    <record id="action_shop_schedule_board" model="ir.actions.act_window">
        <field name="name">Shop Schedule</field>
        <field name="res_model">resource.booking</field>
        <field name="view_mode">calendar,list,form</field>
        <field
            name="search_view_id"
            ref="resource_booking.resource_booking_view_search"
        />
        <field name="domain">[('type_id.shop_repair_ok', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing is booked yet</p>
            <p>Appointments show up here once jobs are scheduled. Group by
               technician to see each person's day.</p>
        </field>
    </record>
</odoo>
