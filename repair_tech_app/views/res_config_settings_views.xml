<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.repair_tech_app</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='barcode_setting_container']" position="after">
                <block title="Technician App" name="repair_tech_app_setting_container">
                    <setting
                        help="Technicians close a job from the app; off, the office does"
                    >
                        <field name="repair_tech_allow_finish" />
                    </setting>
                    <setting help="Jobs nobody has yet show on every technician's list">
                        <field name="repair_tech_show_unassigned" />
                    </setting>
                    <setting
                        help="Also list jobs where the technician is the Responsible"
                    >
                        <field name="repair_tech_include_responsible" />
                    </setting>
                    <setting help="A problem grade needs a photo of the item first">
                        <field name="repair_tech_require_photo_on_fail" />
                    </setting>
                    <setting string="Catalog page size">
                        <field name="repair_tech_catalog_page_size" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
