<odoo>
    <!-- The seed runs once on install. This makes it re-runnable from
         Settings ▸ Technical ▸ Server Actions, which tops up anything that
         was deleted by hand without duplicating what is still there. -->
    <record id="action_reseed_demo" model="ir.actions.server">
        <field name="name">Shop Demo: seed / top up demo data</field>
        <field name="model_id" ref="base.model_res_company" />
        <field name="state">code</field>
        <field name="code">action = env["shop.demo.seed"].action_reseed()</field>
    </record>
</odoo>
